<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: for Android see also Platforms/Android/Resources/values/colors.xml -->

    <!-- Brand -->
    <Color x:Key="Primary">#534AB7</Color>
    <Color x:Key="PrimaryDarkMode">#AFA9EC</Color>
    <Color x:Key="PrimarySoftLight">#EEEDFE</Color>
    <Color x:Key="PrimarySoftDark">#26215C</Color>

    <!-- Semantic -->
    <Color x:Key="PositiveLight">#0F6E56</Color>
    <Color x:Key="PositiveDark">#5DCAA5</Color>
    <Color x:Key="Positive">#1D9E75</Color>
    <Color x:Key="PositiveSoftLight">#E1F5EE</Color>
    <Color x:Key="PositiveSoftDark">#0B3B30</Color>
    <Color x:Key="NegativeLight">#E11D48</Color>
    <Color x:Key="NegativeDark">#FB7185</Color>

    <!-- Surfaces -->
    <Color x:Key="PageLight">#F4F5FA</Color>
    <Color x:Key="PageDark">#0B0D12</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#161922</Color>
    <Color x:Key="SurfaceMutedLight">#ECEEF5</Color>
    <Color x:Key="SurfaceMutedDark">#222633</Color>
    <Color x:Key="DividerLight">#E2E8F0</Color>
    <Color x:Key="DividerDark">#2A2F3C</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryLight">#0F172A</Color>
    <Color x:Key="TextPrimaryDark">#F1F5F9</Color>
    <Color x:Key="TextSecondaryLight">#64748B</Color>
    <Color x:Key="TextSecondaryDark">#94A3B8</Color>
    <Color x:Key="TextTertiaryLight">#94A3B8</Color>
    <Color x:Key="TextTertiaryDark">#5B6475</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="WhiteSoft">#D9FFFFFF</Color>
    <Color x:Key="WhiteGlass">#26FFFFFF</Color>

    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3C3489" Offset="0" />
        <GradientStop Color="#534AB7" Offset="0.55" />
        <GradientStop Color="#7F77DD" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3C3489" Offset="0" />
        <GradientStop Color="#534AB7" Offset="0.55" />
        <GradientStop Color="#7F77DD" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
