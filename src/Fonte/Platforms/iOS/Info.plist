<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Languages the app is translated into (also enables the per-app language option in iOS Settings). -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>fr</string>
		<string>nl</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>__MAUI_DEFAULT_SCENE_CONFIGURATION__</string>
					<key>UISceneDelegateClassName</key>
					<string>SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- Progress photos: taken with the camera or picked from the library, kept in the app, behind Face ID. -->
	<key>NSCameraUsageDescription</key>
	<string>Fonte uses the camera to take your progress photos. They stay on your phone.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Fonte lets you pick progress photos from your library. They are copied into the app and stay on your phone.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Fonte uses Face ID to keep your progress photos private.</string>
	<!-- Apple Health (Fonte Pro). Nothing leaves the phone. -->
	<key>NSHealthShareUsageDescription</key>
	<string>Fonte reads your body weight from Health to follow it next to your training.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Fonte saves your strength workouts to Health, with their start and end time.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
</dict>
</plist>
