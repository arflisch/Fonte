<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:label="Fonte"></application>
	<!-- Everything stays on the device: no network permission is needed. -->
	<uses-permission android:name="android.permission.VIBRATE" />
	<!-- "Rest is over" alert while the phone is locked (asked at runtime on Android 13+). -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<!-- Rings on time rather than up to a minute late (granted by default up to Android 13, in the settings after). -->
	<uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
	<!-- The screen stays on during a workout. -->
	<uses-permission android:name="android.permission.WAKE_LOCK" />
	<!-- Progress photos taken with the camera. -->
	<uses-permission android:name="android.permission.CAMERA" />
	<queries>
		<intent>
			<action android:name="android.media.action.IMAGE_CAPTURE" />
		</intent>
	</queries>
</manifest>
