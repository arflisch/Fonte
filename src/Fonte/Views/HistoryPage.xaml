<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Fonte.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Fonte.Controls"
    xmlns:l="clr-namespace:Fonte.Localization"
    xmlns:vm="clr-namespace:Fonte.ViewModels"
    x:DataType="vm:HistoryViewModel"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    SafeAreaEdges="None">

    <ContentPage.Resources>
        <Style x:Key="StatValue" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="LineBreakMode" Value="NoWrap" />
        </Style>
        <Style x:Key="StatLabel" TargetType="Label" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid
        RowDefinitions="Auto,*"
        SafeAreaEdges="Container,Container,Container,None"
        Style="{StaticResource PageColumn}">

        <!-- Top bar -->
        <Grid Padding="20,8,20,6" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border
                c:Touch.Command="{Binding GoBackCommand}"
                Style="{StaticResource IconButton}"
                SemanticProperties.Description="{l:Tr Common_Back}">
                <c:IconView Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" Data="{x:Static c:Icons.ChevronLeft}" />
            </Border>
            <Label Grid.Column="1" Style="{StaticResource PageTitle}" Text="{l:Tr Home_History}" />
            <BoxView Grid.Column="2" WidthRequest="42" Color="Transparent" />
        </Grid>

        <ScrollView Grid.Row="1" SafeAreaEdges="None">
            <VerticalStackLayout Padding="20,8,20,40" Spacing="18">

                <!-- Calendar -->
                <Border Padding="16,14,16,16" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="40,*,40">
                            <Border
                                Padding="9"
                                c:Touch.Command="{Binding PreviousMonthCommand}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                                HeightRequest="36"
                                StrokeShape="RoundRectangle 18"
                                StrokeThickness="0"
                                WidthRequest="36"
                                SemanticProperties.Description="{l:Tr History_PreviousMonth}">
                                <c:IconView Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" Data="{x:Static c:Icons.ChevronLeft}" />
                            </Border>
                            <Label
                                Grid.Column="1"
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource Strong}"
                                Text="{Binding MonthTitle}"
                                VerticalTextAlignment="Center" />
                            <Border
                                Grid.Column="2"
                                Padding="9"
                                c:Touch.Command="{Binding NextMonthCommand}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                                HeightRequest="36"
                                IsVisible="{Binding CanGoNext}"
                                StrokeShape="RoundRectangle 18"
                                StrokeThickness="0"
                                WidthRequest="36"
                                SemanticProperties.Description="{l:Tr History_NextMonth}">
                                <c:IconView Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" Data="{x:Static c:Icons.ChevronRight}" />
                            </Border>
                        </Grid>

                        <Grid BindableLayout.ItemsSource="{Binding DayHeaders}" ColumnDefinitions="*,*,*,*,*,*,*">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CalendarDayHeader">
                                    <Label
                                        Grid.Column="{Binding Column}"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="12"
                                        HorizontalTextAlignment="Center"
                                        Style="{StaticResource Caption}"
                                        Text="{Binding Letter}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>

                        <Grid
                            BindableLayout.ItemsSource="{Binding Days}"
                            ColumnDefinitions="*,*,*,*,*,*,*"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                            RowSpacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CalendarDay">
                                    <Grid
                                        Grid.Row="{Binding Row}"
                                        Grid.Column="{Binding Column}"
                                        c:Touch.Command="{Binding OpenCommand}"
                                        HeightRequest="38"
                                        HorizontalOptions="Center"
                                        Opacity="{Binding Opacity}"
                                        WidthRequest="38">
                                        <Ellipse Fill="{StaticResource AccentGradient}" IsVisible="{Binding IsDone}" />
                                        <Ellipse
                                            IsVisible="{Binding IsTodayToDo}"
                                            Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkMode}}"
                                            StrokeThickness="2" />
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="14"
                                            HorizontalOptions="Center"
                                            Text="{Binding Number}"
                                            VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger Binding="{Binding IsDone}" TargetType="Label" Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Month totals -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border Padding="8,12" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="0">
                            <Label Style="{StaticResource StatValue}" Text="{Binding CountText}" />
                            <Label Style="{StaticResource StatLabel}" Text="{l:Tr History_Workouts}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Padding="8,12" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="0">
                            <Label Style="{StaticResource StatValue}" Text="{Binding HoursText}" />
                            <Label Style="{StaticResource StatLabel}" Text="{l:Tr History_Time}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Padding="8,12" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="0">
                            <Label Style="{StaticResource StatValue}" Text="{Binding StreakText}" />
                            <Label Style="{StaticResource StatLabel}" Text="{l:Tr History_Streak}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
                <Label
                    Margin="0,-8,0,0"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource Caption}"
                    Text="{Binding VolumeText}" />

                <!-- The month's workouts -->
                <Border Padding="22,24" IsVisible="{Binding HasWorkouts, Converter={StaticResource InvertBool}}" Style="{StaticResource Card}">
                    <Label HorizontalTextAlignment="Center" Style="{StaticResource Secondary}" Text="{l:Tr History_Empty}" />
                </Border>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Workouts}" IsVisible="{Binding HasWorkouts}" Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkoutItemViewModel">
                            <Border Padding="14" c:Touch.Command="{Binding OpenCommand}" Style="{StaticResource Card}">
                                <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="14">
                                    <Border
                                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                                        HeightRequest="52"
                                        StrokeShape="RoundRectangle 16"
                                        StrokeThickness="0"
                                        VerticalOptions="Center"
                                        WidthRequest="52">
                                        <VerticalStackLayout Spacing="-4" VerticalOptions="Center">
                                            <Label
                                                FontFamily="OpenSansSemibold"
                                                FontSize="20"
                                                HorizontalOptions="Center"
                                                Text="{Binding DayNumber}"
                                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkMode}}" />
                                            <Label
                                                FontFamily="OpenSansSemibold"
                                                FontSize="10"
                                                HorizontalOptions="Center"
                                                Text="{Binding Month}"
                                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkMode}}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label FontSize="12" Style="{StaticResource Caption}" Text="{Binding DayText}" />
                                        <Label LineBreakMode="TailTruncation" Style="{StaticResource Strong}" Text="{Binding Title}" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding Caption}" />
                                    </VerticalStackLayout>
                                    <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                                        <Label FontSize="18" Text="{Binding Feeling}" VerticalOptions="Center" />
                                        <Border
                                            Padding="8,4"
                                            BackgroundColor="#26EF9F27"
                                            IsVisible="{Binding HasRecords}"
                                            StrokeShape="RoundRectangle 11"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="4">
                                                <c:IconView
                                                    Color="#BA7517"
                                                    Data="{x:Static c:Icons.Trophy}"
                                                    HeightRequest="14"
                                                    VerticalOptions="Center"
                                                    WidthRequest="14" />
                                                <Label
                                                    FontFamily="OpenSansSemibold"
                                                    FontSize="13"
                                                    Text="{Binding RecordsText}"
                                                    TextColor="#BA7517"
                                                    VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
