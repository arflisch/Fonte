<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Fonte.Views.MealPlannerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Fonte.Controls"
    xmlns:l="clr-namespace:Fonte.Localization"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Fonte.ViewModels"
    x:DataType="vm:MealPlannerViewModel"
    ios:Page.ModalPresentationStyle="PageSheet"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All"
    Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Padding="20,18,20,6" ColumnDefinitions="100,*,100">
            <Label
                c:Touch.Command="{Binding CloseCommand}"
                Style="{StaticResource LinkLabel}"
                Text="{l:Tr Common_Cancel}" />
            <Label Grid.Column="1" Style="{StaticResource PageTitle}" Text="{l:Tr Planner_Title}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8,20,24" Spacing="18">
                <Label Style="{StaticResource Secondary}" Text="{l:Tr Planner_Intro}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource FieldLabel}" Text="{l:Tr CustomFood_Kcal}" />
                        <Border Style="{StaticResource InputField}">
                            <Entry Keyboard="Numeric" MaxLength="5" Text="{Binding KcalTarget}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Planner_Protein}" />
                        <Border Style="{StaticResource InputField}">
                            <Entry Keyboard="Numeric" MaxLength="4" Text="{Binding ProteinTarget}" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Planner_Ingredients}" />
                    <Border Padding="16,4" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlannedFoodItem">
                                        <Grid Padding="0,10" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout VerticalOptions="Center">
                                                <Label LineBreakMode="TailTruncation" Text="{Binding Name}" />
                                                <Label Style="{StaticResource Caption}" Text="{Binding Detail}" />
                                            </VerticalStackLayout>
                                            <Label
                                                Grid.Column="1"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="17"
                                                Text="{Binding Grams}"
                                                TextColor="{DynamicResource Accent}"
                                                VerticalOptions="Center" />
                                            <Border
                                                Grid.Column="2"
                                                Padding="8"
                                                c:Touch.Command="{Binding RemoveCommand}"
                                                HeightRequest="32"
                                                StrokeThickness="0"
                                                VerticalOptions="Center"
                                                WidthRequest="32">
                                                <c:IconView
                                                    Color="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                                                    Data="{x:Static c:Icons.Close}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <HorizontalStackLayout Padding="0,12" c:Touch.Command="{Binding AddFoodCommand}" Spacing="6">
                                <c:IconView
                                    Color="{DynamicResource Accent}"
                                    Data="{x:Static c:Icons.Plus}"
                                    HeightRequest="16"
                                    StrokeWidth="2.4"
                                    VerticalOptions="Center"
                                    WidthRequest="16" />
                                <Label Style="{StaticResource LinkLabel}" Text="{l:Tr Planner_AddFood}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Border
                    Background="{DynamicResource HeroGradient}"
                    IsVisible="{Binding HasPlan}"
                    StrokeShape="RoundRectangle 22"
                    StrokeThickness="0">
                    <VerticalStackLayout Padding="20,16" Spacing="4">
                        <Label FontFamily="OpenSansSemibold" FontSize="13" Text="{l:Tr Planner_Result}" TextColor="{StaticResource WhiteSoft}" />
                        <Label FontFamily="OpenSansSemibold" FontSize="26" Text="{Binding TotalText}" TextColor="White" />
                        <Label FontSize="14" Text="{Binding MacrosText}" TextColor="White" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding HasPlan}" Spacing="12">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Recipes_Steps}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Steps}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:StepItem">
                                <Grid ColumnDefinitions="30,*" ColumnSpacing="10">
                                    <Border
                                        BackgroundColor="{DynamicResource AccentSoft}"
                                        HeightRequest="26"
                                        StrokeShape="RoundRectangle 13"
                                        StrokeThickness="0"
                                        VerticalOptions="Start"
                                        WidthRequest="26">
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="13"
                                            HorizontalOptions="Center"
                                            Text="{Binding Number}"
                                            TextColor="{DynamicResource Accent}"
                                            VerticalOptions="Center" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding Text}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Border
            Grid.Row="2"
            Margin="20,8,20,12"
            c:Touch.Command="{Binding AddCommand}"
            IsVisible="{Binding HasPlan}"
            Style="{StaticResource PrimaryButton}">
            <Label Style="{StaticResource PrimaryButtonText}" Text="{Binding AddText}" />
        </Border>
    </Grid>
</ContentPage>
