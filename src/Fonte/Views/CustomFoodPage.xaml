<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Fonte.Views.CustomFoodPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Fonte.Controls"
    xmlns:l="clr-namespace:Fonte.Localization"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Fonte.ViewModels"
    x:DataType="vm:CustomFoodViewModel"
    ios:Page.ModalPresentationStyle="PageSheet"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All"
    Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="Auto,*">
        <!-- Sheet header -->
        <Grid Padding="20,18,20,6" ColumnDefinitions="100,*,100">
            <Label
                c:Touch.Command="{Binding CancelCommand}"
                Style="{StaticResource LinkLabel}"
                Text="{l:Tr Common_Cancel}" />
            <Label Grid.Column="1" Style="{StaticResource PageTitle}" Text="{Binding Title}" />
            <Label
                Grid.Column="2"
                c:Touch.Command="{Binding SaveCommand}"
                HorizontalTextAlignment="End"
                Style="{StaticResource LinkLabel}"
                Text="{l:Tr Common_Save}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,12,20,32" Spacing="18">

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr CustomFood_Name}" />
                    <Border Style="{StaticResource InputField}">
                        <Entry
                            IsSpellCheckEnabled="False"
                            IsTextPredictionEnabled="False"
                            Keyboard="Text"
                            MaxLength="120"
                            Placeholder="{l:Tr CustomFood_NamePlaceholder}"
                            ReturnType="Next"
                            Text="{Binding Name}" />
                    </Border>
                    <Label IsVisible="{Binding HasBarcode}" Style="{StaticResource Caption}" Text="{Binding BarcodeText}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr CustomFood_Brand}" />
                    <Border Style="{StaticResource InputField}">
                        <Entry
                            IsSpellCheckEnabled="False"
                            IsTextPredictionEnabled="False"
                            Keyboard="Text"
                            MaxLength="80"
                            Placeholder="{l:Tr CustomFood_Optional}"
                            Text="{Binding Brand}" />
                    </Border>
                </VerticalStackLayout>

                <Label Margin="0,6,0,-6" Style="{StaticResource SectionTitle}" Text="{l:Tr CustomFood_Per100}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="8">
                        <Label Style="{StaticResource FieldLabel}" Text="{l:Tr CustomFood_Kcal}" />
                        <Border Style="{StaticResource InputField}">
                            <Entry Keyboard="Numeric" MaxLength="6" Placeholder="{Binding KcalPlaceholder}" Text="{Binding Kcal}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Nutrition_Protein}" />
                        <Border Style="{StaticResource InputField}">
                            <Entry Keyboard="Numeric" MaxLength="6" Placeholder="0" Text="{Binding Protein}" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="8">
                        <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Nutrition_Carbs}" />
                        <Border Style="{StaticResource InputField}">
                            <Entry Keyboard="Numeric" MaxLength="6" Placeholder="0" Text="{Binding Carbs}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Nutrition_Fat}" />
                        <Border Style="{StaticResource InputField}">
                            <Entry Keyboard="Numeric" MaxLength="6" Placeholder="0" Text="{Binding Fat}" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="8">
                        <Label Style="{StaticResource FieldLabel}" Text="{l:Tr CustomFood_Sugars}" />
                        <Border Style="{StaticResource InputField}">
                            <Entry Keyboard="Numeric" MaxLength="6" Placeholder="—" Text="{Binding Sugars}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label Style="{StaticResource FieldLabel}" Text="{l:Tr CustomFood_Fiber}" />
                        <Border Style="{StaticResource InputField}">
                            <Entry Keyboard="Numeric" MaxLength="6" Placeholder="—" Text="{Binding Fiber}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="8">
                        <Label Style="{StaticResource FieldLabel}" Text="{l:Tr CustomFood_Salt}" />
                        <Border Style="{StaticResource InputField}">
                            <Entry Keyboard="Numeric" MaxLength="6" Placeholder="—" Text="{Binding Salt}" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>
                <Label Style="{StaticResource Caption}" Text="{l:Tr CustomFood_KcalHint}" />

                <Label Margin="0,6,0,-6" Style="{StaticResource SectionTitle}" Text="{l:Tr CustomFood_Serving}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="8">
                        <Label Style="{StaticResource FieldLabel}" Text="{l:Tr CustomFood_ServingName}" />
                        <Border Style="{StaticResource InputField}">
                            <Entry Keyboard="Text" MaxLength="40" Placeholder="{l:Tr CustomFood_ServingNamePlaceholder}" Text="{Binding ServingName}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label Style="{StaticResource FieldLabel}" Text="{l:Tr CustomFood_ServingGrams}" />
                        <Border Style="{StaticResource InputField}">
                            <Entry Keyboard="Numeric" MaxLength="6" Placeholder="—" Text="{Binding ServingGrams}" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <Label IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" Text="{Binding ErrorMessage}" />

                <Label
                    Margin="0,8,0,0"
                    c:Touch.Command="{Binding RemoveCommand}"
                    HorizontalOptions="Center"
                    IsVisible="{Binding CanRemove}"
                    Style="{StaticResource LinkLabel}"
                    Text="{l:Tr CustomFood_Remove}"
                    TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
