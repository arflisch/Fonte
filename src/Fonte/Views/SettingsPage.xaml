<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Fonte.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Fonte.Controls"
    xmlns:l="clr-namespace:Fonte.Localization"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Fonte.ViewModels"
    x:DataType="vm:SettingsViewModel"
    ios:Page.ModalPresentationStyle="PageSheet"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All"
    Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="Auto,*">
        <!-- Sheet header -->
        <Grid Padding="20,18,20,6" ColumnDefinitions="90,*,90">
            <Label
                c:Touch.Command="{Binding CloseCommand}"
                Style="{StaticResource LinkLabel}"
                Text="{l:Tr Common_Close}" />
            <Label Grid.Column="1" Style="{StaticResource PageTitle}" Text="{l:Tr Settings_Title}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,14,20,32" Spacing="10">

                <!-- Training -->
                <Label Margin="0,4,0,0" Style="{StaticResource FieldLabel}" Text="{l:Tr Settings_TrainingSection}" />
                <Border Padding="16,0" Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Grid c:Touch.Command="{Binding ChooseGoalCommand}" Style="{StaticResource Row}">
                            <Border BackgroundColor="#26E24B4A" Style="{StaticResource RowIcon}">
                                <c:IconView Color="#E24B4A" Data="{x:Static c:Icons.Target}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                <Label Style="{StaticResource RowTitle}" Text="{l:Tr Settings_Goal}" />
                                <Label Style="{StaticResource Caption}" Text="{l:Tr Settings_GoalHint}" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                <Label Style="{StaticResource Secondary}" Text="{Binding GoalName}" VerticalOptions="Center" />
                                <c:IconView
                                    Color="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                                    Data="{x:Static c:Icons.ChevronRight}"
                                    HeightRequest="16"
                                    VerticalOptions="Center"
                                    WidthRequest="16" />
                            </HorizontalStackLayout>
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid c:Touch.Command="{Binding ChooseSessionsCommand}" Style="{StaticResource Row}">
                            <Border BackgroundColor="#261D9E75" Style="{StaticResource RowIcon}">
                                <c:IconView Color="#1D9E75" Data="{x:Static c:Icons.Calendar}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                <Label Style="{StaticResource RowTitle}" Text="{l:Tr Settings_Sessions}" />
                                <Label Style="{StaticResource Caption}" Text="{l:Tr Settings_SessionsHint}" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                <Label Style="{StaticResource Secondary}" Text="{Binding SessionsText}" VerticalOptions="Center" />
                                <c:IconView
                                    Color="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                                    Data="{x:Static c:Icons.ChevronRight}"
                                    HeightRequest="16"
                                    VerticalOptions="Center"
                                    WidthRequest="16" />
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Workout -->
                <Label Margin="0,14,0,0" Style="{StaticResource FieldLabel}" Text="{l:Tr Settings_WorkoutSection}" />
                <Border Padding="16,0" Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource Row}">
                            <Border BackgroundColor="{DynamicResource AccentTint}" Style="{StaticResource RowIcon}">
                                <c:IconView Color="{DynamicResource Primary}" Data="{x:Static c:Icons.Timer}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                <Label Style="{StaticResource RowTitle}" Text="{l:Tr Settings_RestTimer}" />
                                <Label Style="{StaticResource Caption}" Text="{l:Tr Settings_RestTimerHint}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="2" IsToggled="{Binding IsRestTimerEnabled}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView IsVisible="{Binding IsRestTimerEnabled}" Style="{StaticResource Divider}" />
                        <Grid
                            c:Touch.Command="{Binding ChooseRestCommand}"
                            IsVisible="{Binding IsRestTimerEnabled}"
                            Style="{StaticResource Row}">
                            <Border BackgroundColor="#26D97706" Style="{StaticResource RowIcon}">
                                <c:IconView Color="#D97706" Data="{x:Static c:Icons.Bell}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                <Label Style="{StaticResource RowTitle}" Text="{l:Tr Settings_Rest}" />
                                <Label Style="{StaticResource Caption}" Text="{l:Tr Settings_RestHint}" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                <Label Style="{StaticResource Secondary}" Text="{Binding RestText}" VerticalOptions="Center" />
                                <c:IconView
                                    Color="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                                    Data="{x:Static c:Icons.ChevronRight}"
                                    HeightRequest="16"
                                    VerticalOptions="Center"
                                    WidthRequest="16" />
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Plates -->
                <Label Margin="0,14,0,0" Style="{StaticResource FieldLabel}" Text="{l:Tr Settings_PlatesSection}" />
                <Border Padding="16,14" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Style="{StaticResource Caption}" Text="{l:Tr Settings_PlatesHint}" />
                        <FlexLayout BindableLayout.ItemsSource="{Binding PlateOptions}" Wrap="Wrap">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SelectableOption">
                                    <Border
                                        Margin="0,0,8,8"
                                        c:Touch.Command="{Binding SelectCommand}"
                                        Style="{StaticResource Chip}">
                                        <Border.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" TargetType="Border" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentGradient}" />
                                                <Setter Property="Stroke" Value="Transparent" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label FontFamily="OpenSansSemibold" FontSize="14" Text="{Binding Label}">
                                            <Label.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" TargetType="Label" Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <HorizontalStackLayout c:Touch.Command="{Binding OpenPlatesCommand}" Spacing="6">
                            <c:IconView
                                Color="{DynamicResource Accent}"
                                Data="{x:Static c:Icons.Plate}"
                                HeightRequest="18"
                                VerticalOptions="Center"
                                WidthRequest="18" />
                            <Label Style="{StaticResource LinkLabel}" Text="{l:Tr Settings_OpenPlates}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Display -->
                <Label Margin="0,14,0,0" Style="{StaticResource FieldLabel}" Text="{l:Tr Settings_Display}" />
                <Border Padding="16,0" Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <!-- Colour of the app -->
                        <Grid Style="{StaticResource Row}">
                            <Border BackgroundColor="{DynamicResource AccentTint}" Style="{StaticResource RowIcon}">
                                <c:IconView Color="{DynamicResource Primary}" Data="{x:Static c:Icons.Palette}" />
                            </Border>
                            <Label Grid.Column="1" Style="{StaticResource RowTitle}" Text="{l:Tr Settings_Accent}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Style="{StaticResource Secondary}" Text="{Binding AccentName}" VerticalOptions="Center" />
                        </Grid>
                        <Grid
                            Margin="0,0,0,14"
                            BindableLayout.ItemsSource="{Binding AccentOptions}"
                            ColumnDefinitions="*,*,*,*,*,*,*,*">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SelectableOption">
                                    <Grid
                                        Grid.Column="{Binding Column}"
                                        c:Touch.Command="{Binding SelectCommand}"
                                        HeightRequest="34"
                                        HorizontalOptions="Center"
                                        WidthRequest="34"
                                        SemanticProperties.Description="{Binding Label}">
                                        <!-- Ring around the colour in use -->
                                        <Ellipse
                                            IsVisible="{Binding IsSelected}"
                                            Stroke="{Binding Accent}"
                                            StrokeThickness="2" />
                                        <Ellipse Fill="{Binding Accent}" Margin="0">
                                            <Ellipse.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" TargetType="Ellipse" Value="True">
                                                    <Setter Property="Margin" Value="5" />
                                                </DataTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <c:IconView
                                            Color="White"
                                            Data="{x:Static c:Icons.Check}"
                                            HeightRequest="14"
                                            HorizontalOptions="Center"
                                            IsVisible="{Binding IsSelected}"
                                            StrokeWidth="3"
                                            VerticalOptions="Center"
                                            WidthRequest="14" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid c:Touch.Command="{Binding ChooseLanguageCommand}" Style="{StaticResource Row}">
                            <Border BackgroundColor="#260891B2" Style="{StaticResource RowIcon}">
                                <c:IconView Color="#0891B2" Data="{x:Static c:Icons.Globe}" />
                            </Border>
                            <Label Grid.Column="1" Style="{StaticResource RowTitle}" Text="{l:Tr Settings_Language}" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                <Label Style="{StaticResource Secondary}" Text="{Binding LanguageName}" VerticalOptions="Center" />
                                <c:IconView
                                    Color="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                                    Data="{x:Static c:Icons.ChevronRight}"
                                    HeightRequest="16"
                                    VerticalOptions="Center"
                                    WidthRequest="16" />
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Backup -->
                <Label Margin="0,14,0,0" Style="{StaticResource FieldLabel}" Text="{l:Tr Settings_BackupSection}" />
                <Border Padding="16,0" Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Grid c:Touch.Command="{Binding BackUpCommand}" Style="{StaticResource Row}">
                            <Border BackgroundColor="#262563EB" Style="{StaticResource RowIcon}">
                                <c:IconView Color="#2563EB" Data="{x:Static c:Icons.Upload}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                <Label Style="{StaticResource RowTitle}" Text="{l:Tr Settings_BackUp}" />
                                <Label Style="{StaticResource Caption}" Text="{Binding LastBackupText}" />
                            </VerticalStackLayout>
                            <ActivityIndicator
                                Grid.Column="2"
                                HeightRequest="20"
                                IsRunning="{Binding IsBackupBusy}"
                                IsVisible="{Binding IsBackupBusy}"
                                VerticalOptions="Center"
                                WidthRequest="20"
                                Color="{DynamicResource Primary}" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid c:Touch.Command="{Binding RestoreCommand}" Style="{StaticResource Row}">
                            <Border BackgroundColor="#2664748B" Style="{StaticResource RowIcon}">
                                <c:IconView Color="#64748B" Data="{x:Static c:Icons.Download}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                <Label Style="{StaticResource RowTitle}" Text="{l:Tr Settings_Restore}" />
                                <Label Style="{StaticResource Caption}" Text="{l:Tr Settings_RestoreHint}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Label Margin="4,0" Style="{StaticResource Caption}" Text="{Binding BackupHint}" />

                <Label
                    Margin="0,24,0,0"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource Caption}"
                    Text="{Binding AppVersion}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
