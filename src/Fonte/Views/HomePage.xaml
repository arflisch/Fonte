<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Fonte.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Fonte.Controls"
    xmlns:l="clr-namespace:Fonte.Localization"
    xmlns:vm="clr-namespace:Fonte.ViewModels"
    x:DataType="vm:HomeViewModel"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="None">

    <!-- Top, left and right stay clear of the notch; the list scrolls under the home indicator. -->
    <Grid SafeAreaEdges="Container,Container,Container,None" Style="{StaticResource PageColumn}">
        <ScrollView SafeAreaEdges="None">
            <VerticalStackLayout Padding="20,12,20,40" Spacing="22">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label Style="{StaticResource Caption}" Text="{Binding TodayText}" />
                        <Label Style="{StaticResource LargeTitle}" Text="{l:Tr Tab_Workouts}" />
                    </VerticalStackLayout>
                    <Border
                        Grid.Column="1"
                        c:Touch.Command="{Binding OpenSettingsCommand}"
                        Style="{StaticResource IconButton}"
                        VerticalOptions="Center"
                        SemanticProperties.Description="{l:Tr Settings_Title}">
                        <c:IconView Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" Data="{x:Static c:Icons.Settings}" />
                    </Border>
                </Grid>

                <!-- Start or resume -->
                <Border
                    Background="{DynamicResource HeroGradient}"
                    Shadow="{DynamicResource FloatingShadow}"
                    StrokeShape="RoundRectangle 28"
                    StrokeThickness="0">
                    <Grid>
                        <Ellipse
                            Margin="0,-110,-80,0"
                            Fill="#1AFFFFFF"
                            HeightRequest="240"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            WidthRequest="240" />
                        <Ellipse
                            Margin="-60,0,0,-80"
                            Fill="#12FFFFFF"
                            HeightRequest="170"
                            HorizontalOptions="Start"
                            VerticalOptions="End"
                            WidthRequest="170" />

                        <VerticalStackLayout Padding="24,24,24,24" Spacing="6">
                            <!-- Nothing started, nothing planned -->
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="24"
                                IsVisible="{Binding IsFree}"
                                Text="{l:Tr Home_ReadyTitle}"
                                TextColor="White" />
                            <Label
                                FontSize="15"
                                IsVisible="{Binding IsFree}"
                                Text="{l:Tr Home_ReadyText}"
                                TextColor="{StaticResource WhiteSoft}" />

                            <!-- Next workout of the program -->
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="13"
                                IsVisible="{Binding HasNext}"
                                Text="{Binding NextLabel}"
                                TextColor="{StaticResource WhiteSoft}" />
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="26"
                                IsVisible="{Binding HasNext}"
                                Text="{Binding NextName}"
                                TextColor="White" />
                            <Label
                                FontSize="15"
                                IsVisible="{Binding HasNext}"
                                Text="{Binding NextText}"
                                TextColor="{StaticResource WhiteSoft}" />

                            <!-- Workout in progress -->
                            <HorizontalStackLayout IsVisible="{Binding IsInProgress}" Spacing="8">
                                <Ellipse
                                    Fill="#5DCAA5"
                                    HeightRequest="10"
                                    VerticalOptions="Center"
                                    WidthRequest="10" />
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="24"
                                    Text="{l:Tr Home_InProgress}"
                                    TextColor="White" />
                            </HorizontalStackLayout>
                            <Label
                                FontSize="15"
                                IsVisible="{Binding IsInProgress}"
                                Text="{Binding InProgressText}"
                                TextColor="{StaticResource WhiteSoft}" />

                            <Border
                                Margin="0,14,0,0"
                                c:Touch.Command="{Binding StartCommand}"
                                BackgroundColor="White"
                                HeightRequest="52"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="0">
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                    <c:IconView
                                        Color="{DynamicResource Primary}"
                                        Data="{x:Static c:Icons.Plus}"
                                        HeightRequest="20"
                                        IsVisible="{Binding IsFree}"
                                        StrokeWidth="2.6"
                                        VerticalOptions="Center"
                                        WidthRequest="20" />
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="16"
                                        IsVisible="{Binding IsFree}"
                                        Text="{l:Tr Home_Start}"
                                        TextColor="{DynamicResource Primary}"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="16"
                                        IsVisible="{Binding HasNext}"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding StartNextText}"
                                        TextColor="{DynamicResource Primary}"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="16"
                                        IsVisible="{Binding IsInProgress}"
                                        Text="{l:Tr Home_Resume}"
                                        TextColor="{DynamicResource Primary}"
                                        VerticalOptions="Center" />
                                    <c:IconView
                                        Color="{DynamicResource Primary}"
                                        Data="{x:Static c:Icons.ChevronRight}"
                                        HeightRequest="18"
                                        IsVisible="{Binding IsInProgress}"
                                        StrokeWidth="2.6"
                                        VerticalOptions="Center"
                                        WidthRequest="18" />
                                </HorizontalStackLayout>
                            </Border>
                            <Label
                                Padding="0,10,0,0"
                                c:Touch.Command="{Binding StartFreeCommand}"
                                FontFamily="OpenSansSemibold"
                                FontSize="14"
                                HorizontalOptions="Center"
                                IsVisible="{Binding HasNext}"
                                Text="{l:Tr Home_StartFree}"
                                TextColor="White" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- This week -->
                <Border
                    Padding="18,16"
                    c:Touch.Command="{Binding OpenHistoryCommand}"
                    IsVisible="{Binding IsLoaded}"
                    Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Home_ThisWeek}" VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontFamily="OpenSansSemibold"
                                FontSize="14"
                                Text="{Binding WeekText}"
                                TextColor="{DynamicResource Accent}"
                                VerticalOptions="Center" />
                        </Grid>
                        <c:ProgressPill
                            Margin="0,-6,0,0"
                            FillColor="{DynamicResource Accent}"
                            HeightRequest="6"
                            Progress="{Binding WeekProgress}"
                            TrackColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}">
                            <c:ProgressPill.Triggers>
                                <DataTrigger Binding="{Binding IsWeekGoalMet}" TargetType="c:ProgressPill" Value="True">
                                    <Setter Property="FillColor" Value="{StaticResource Positive}" />
                                </DataTrigger>
                            </c:ProgressPill.Triggers>
                        </c:ProgressPill>
                        <Grid BindableLayout.ItemsSource="{Binding Week}" ColumnDefinitions="*,*,*,*,*,*,*">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:WeekDayItem">
                                    <Grid
                                        Grid.Column="{Binding Index}"
                                        HeightRequest="38"
                                        HorizontalOptions="Center"
                                        WidthRequest="38">
                                        <!-- Trained -->
                                        <Ellipse
                                            Fill="{DynamicResource AccentGradient}"
                                            IsVisible="{Binding IsDone}" />
                                        <!-- Today, not trained yet -->
                                        <Ellipse
                                            IsVisible="{Binding IsTodayToDo}"
                                            Stroke="{DynamicResource Accent}"
                                            StrokeThickness="2" />
                                        <!-- Other days -->
                                        <Ellipse
                                            Fill="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                                            IsVisible="{Binding IsRest}" />
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="14"
                                            HorizontalOptions="Center"
                                            Text="{Binding Letter}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                            VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger Binding="{Binding IsDone}" TargetType="Label" Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTodayToDo}" TargetType="Label" Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource Accent}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>
                        <HorizontalStackLayout IsVisible="{Binding HasStreak}" Spacing="6">
                            <c:IconView
                                Color="#EF6C27"
                                Data="{x:Static c:Icons.Flame}"
                                HeightRequest="18"
                                VerticalOptions="Center"
                                WidthRequest="18" />
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="14"
                                Text="{Binding StreakText}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- No workout yet -->
                <Border
                    Padding="24,28"
                    IsVisible="{Binding IsEmpty}"
                    Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label FontSize="48" HorizontalOptions="Center" Text="🏋️" />
                        <Label
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource SectionTitle}"
                            Text="{l:Tr Home_EmptyTitle}" />
                        <Label
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource Secondary}"
                            Text="{l:Tr Home_EmptyText}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Last workouts -->
                <VerticalStackLayout IsVisible="{Binding HasRecent}" Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Style="{StaticResource SectionTitle}" Text="{l:Tr Home_Recent}" VerticalOptions="Center" />
                        <HorizontalStackLayout
                            Grid.Column="1"
                            c:Touch.Command="{Binding OpenHistoryCommand}"
                            Spacing="4"
                            VerticalOptions="Center">
                            <c:IconView
                                Color="{DynamicResource Accent}"
                                Data="{x:Static c:Icons.Calendar}"
                                HeightRequest="16"
                                VerticalOptions="Center"
                                WidthRequest="16" />
                            <Label Style="{StaticResource LinkLabel}" Text="{l:Tr Home_History}" />
                        </HorizontalStackLayout>
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Recent}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkoutItemViewModel">
                                <Border
                                    Padding="14"
                                    c:Touch.Command="{Binding OpenCommand}"
                                    Style="{StaticResource Card}">
                                    <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="14">
                                        <!-- Date -->
                                        <Border
                                            BackgroundColor="{DynamicResource AccentSoft}"
                                            HeightRequest="52"
                                            StrokeShape="RoundRectangle 16"
                                            StrokeThickness="0"
                                            VerticalOptions="Center"
                                            WidthRequest="52">
                                            <VerticalStackLayout Spacing="-4" VerticalOptions="Center">
                                                <Label
                                                    FontFamily="OpenSansSemibold"
                                                    FontSize="20"
                                                    HorizontalOptions="Center"
                                                    Text="{Binding DayNumber}"
                                                    TextColor="{DynamicResource Accent}" />
                                                <Label
                                                    FontFamily="OpenSansSemibold"
                                                    FontSize="10"
                                                    HorizontalOptions="Center"
                                                    Text="{Binding Month}"
                                                    TextColor="{DynamicResource Accent}" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label FontSize="12" Style="{StaticResource Caption}" Text="{Binding DayText}" />
                                            <Label
                                                LineBreakMode="TailTruncation"
                                                Style="{StaticResource Strong}"
                                                Text="{Binding Title}" />
                                            <Label Style="{StaticResource Caption}" Text="{Binding Caption}" />
                                        </VerticalStackLayout>

                                        <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                                            <Label FontSize="18" Text="{Binding Feeling}" VerticalOptions="Center" />
                                            <Border
                                                Padding="8,4"
                                                BackgroundColor="#26EF9F27"
                                                IsVisible="{Binding HasRecords}"
                                                StrokeShape="RoundRectangle 11"
                                                StrokeThickness="0"
                                                VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="4">
                                                    <c:IconView
                                                        Color="#BA7517"
                                                        Data="{x:Static c:Icons.Trophy}"
                                                        HeightRequest="14"
                                                        VerticalOptions="Center"
                                                        WidthRequest="14" />
                                                    <Label
                                                        FontFamily="OpenSansSemibold"
                                                        FontSize="13"
                                                        Text="{Binding RecordsText}"
                                                        TextColor="#BA7517"
                                                        VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </Border>
                                            <c:IconView
                                                Color="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                                                Data="{x:Static c:Icons.ChevronRight}"
                                                HeightRequest="16"
                                                VerticalOptions="Center"
                                                WidthRequest="16" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
