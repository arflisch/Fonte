<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Fonte.Views.BodyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Fonte.Controls"
    xmlns:l="clr-namespace:Fonte.Localization"
    xmlns:vm="clr-namespace:Fonte.ViewModels"
    x:DataType="vm:BodyViewModel"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="None">

    <Grid SafeAreaEdges="Container,Container,Container,None" Style="{StaticResource PageColumn}">
        <ScrollView SafeAreaEdges="None">
            <VerticalStackLayout Padding="20,12,20,40" Spacing="18">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Label Style="{StaticResource LargeTitle}" Text="{l:Tr Tab_Body}" VerticalOptions="Center" />
                    <Border
                        Grid.Column="1"
                        c:Touch.Command="{Binding AddWeightCommand}"
                        Style="{StaticResource IconButton}"
                        VerticalOptions="Center"
                        SemanticProperties.Description="{l:Tr Body_AddWeight}">
                        <c:IconView Color="{DynamicResource Accent}" Data="{x:Static c:Icons.Plus}" StrokeWidth="2.4" />
                    </Border>
                </Grid>

                <!-- Body weight -->
                <Border
                    Background="{DynamicResource HeroGradient}"
                    Shadow="{DynamicResource FloatingShadow}"
                    StrokeShape="RoundRectangle 26"
                    StrokeThickness="0">
                    <VerticalStackLayout Padding="22,20,22,16" Spacing="2">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="13"
                                Text="{l:Tr Body_Weight}"
                                TextColor="{StaticResource WhiteSoft}"
                                VerticalOptions="Center" />
                            <Border
                                Grid.Column="1"
                                Padding="12,5"
                                c:Touch.Command="{Binding AddWeightCommand}"
                                BackgroundColor="{StaticResource WhiteGlass}"
                                StrokeShape="RoundRectangle 13"
                                StrokeThickness="0">
                                <HorizontalStackLayout Spacing="4">
                                    <c:IconView
                                        Color="White"
                                        Data="{x:Static c:Icons.Scale}"
                                        HeightRequest="16"
                                        VerticalOptions="Center"
                                        WidthRequest="16" />
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="13"
                                        Text="{l:Tr Body_Weigh}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                        <Label FontFamily="OpenSansSemibold" FontSize="36" Text="{Binding WeightText}" TextColor="White" />
                        <Label FontSize="14" Text="{Binding WeightChangeText}" TextColor="{StaticResource WhiteSoft}" />
                        <c:SparklineView
                            Margin="0,12,0,0"
                            HeightRequest="80"
                            IsVisible="{Binding HasChart}"
                            LineColor="White"
                            Points="{Binding WeightPoints}" />
                        <!-- Goal -->
                        <Border
                            Margin="0,12,0,0"
                            Padding="14,10"
                            c:Touch.Command="{Binding SetGoalCommand}"
                            BackgroundColor="{StaticResource WhiteGlass}"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="0">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <c:IconView
                                        Color="White"
                                        Data="{x:Static c:Icons.Target}"
                                        HeightRequest="18"
                                        VerticalOptions="Center"
                                        WidthRequest="18" />
                                    <Label
                                        Grid.Column="1"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="14"
                                        Text="{Binding GoalText}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                    <c:IconView
                                        Grid.Column="2"
                                        Color="White"
                                        Data="{x:Static c:Icons.Pencil}"
                                        HeightRequest="16"
                                        VerticalOptions="Center"
                                        WidthRequest="16" />
                                </Grid>
                                <c:ProgressPill
                                    FillColor="White"
                                    HeightRequest="6"
                                    IsVisible="{Binding HasGoal}"
                                    Progress="{Binding GoalProgress}"
                                    TrackColor="{StaticResource WhiteGlass}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Last weighings -->
                <Border Padding="16,4" IsVisible="{Binding HasWeights}" Style="{StaticResource Card}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Weighings}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:WeighingItem">
                                <Grid Padding="0,11" c:Touch.Command="{Binding MenuCommand}" ColumnDefinitions="*,Auto">
                                    <Label Style="{StaticResource Secondary}" Text="{Binding DayText}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" FontFamily="OpenSansSemibold" Text="{Binding ValueText}" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- Measurements -->
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource SectionTitle}" Text="{l:Tr Body_Measurements}" />
                    <Grid
                        x:Name="MeasurementsGrid"
                        BindableLayout.ItemsSource="{Binding Measurements}"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10"
                        RowDefinitions="Auto,Auto,Auto"
                        RowSpacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:MeasurementItem">
                                <Border Padding="14,12" c:Touch.Command="{Binding EditCommand}" Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="1">
                                        <Label Style="{StaticResource Caption}" Text="{Binding Name}" />
                                        <HorizontalStackLayout Spacing="8">
                                            <Label FontFamily="OpenSansSemibold" FontSize="20" Text="{Binding ValueText}" VerticalOptions="Center" />
                                            <Label
                                                FontFamily="OpenSansSemibold"
                                                FontSize="13"
                                                Text="{Binding DeltaText}"
                                                TextColor="{DynamicResource Accent}"
                                                VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label FontSize="12" Style="{StaticResource Caption}" Text="{Binding DateText}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </Grid>
                </VerticalStackLayout>

                <!-- Progress photos -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                        <Label Style="{StaticResource SectionTitle}" Text="{l:Tr Body_Photos}" VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            c:Touch.Command="{Binding CompareCommand}"
                            IsVisible="{Binding CanCompare}"
                            Style="{StaticResource LinkLabel}"
                            Text="{l:Tr Body_Compare}" />
                        <HorizontalStackLayout
                            Grid.Column="2"
                            c:Touch.Command="{Binding AddPhotoCommand}"
                            Spacing="4"
                            VerticalOptions="Center">
                            <c:IconView
                                Color="{DynamicResource Accent}"
                                Data="{x:Static c:Icons.Camera}"
                                HeightRequest="18"
                                VerticalOptions="Center"
                                WidthRequest="18" />
                            <Label Style="{StaticResource LinkLabel}" Text="{l:Tr Body_Add}" />
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Locked -->
                    <Border
                        Padding="20,22"
                        c:Touch.Command="{Binding UnlockCommand}"
                        IsVisible="{Binding IsLocked}"
                        Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Border
                                Padding="12"
                                BackgroundColor="{DynamicResource AccentSoft}"
                                HeightRequest="48"
                                HorizontalOptions="Center"
                                StrokeShape="RoundRectangle 24"
                                StrokeThickness="0"
                                WidthRequest="48">
                                <c:IconView Color="{DynamicResource Accent}" Data="{x:Static c:Icons.Lock}" />
                            </Border>
                            <Label HorizontalTextAlignment="Center" Style="{StaticResource LinkLabel}" Text="{Binding UnlockText}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Grid of photos -->
                    <Grid
                        x:Name="PhotosGrid"
                        BindableLayout.ItemsSource="{Binding PhotoItems}"
                        ColumnDefinitions="*,*,*"
                        ColumnSpacing="8"
                        RowSpacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PhotoItem">
                                <Border
                                    c:Touch.Command="{Binding OpenCommand}"
                                    HeightRequest="140"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0">
                                    <Grid>
                                        <Image Aspect="AspectFill" Source="{Binding Image}" />
                                        <Border
                                            Margin="6"
                                            Padding="6,2"
                                            BackgroundColor="#80000000"
                                            HorizontalOptions="Start"
                                            StrokeShape="RoundRectangle 8"
                                            StrokeThickness="0"
                                            VerticalOptions="End">
                                            <Label FontSize="11" Text="{Binding DayText}" TextColor="White" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </Grid>

                    <Label Style="{StaticResource Caption}" Text="{Binding PhotosHint}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
