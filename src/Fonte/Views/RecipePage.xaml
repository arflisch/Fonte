<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Fonte.Views.RecipePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Fonte.Controls"
    xmlns:l="clr-namespace:Fonte.Localization"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Fonte.ViewModels"
    x:DataType="vm:RecipeViewModel"
    ios:Page.ModalPresentationStyle="PageSheet"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All"
    Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="Auto,*">
        <!-- Sheet header -->
        <Grid Padding="20,18,20,6" ColumnDefinitions="100,*,100">
            <Label
                c:Touch.Command="{Binding CancelCommand}"
                Style="{StaticResource LinkLabel}"
                Text="{l:Tr Common_Cancel}" />
            <Label Grid.Column="1" Style="{StaticResource PageTitle}" Text="{Binding Title}" />
            <Label
                Grid.Column="2"
                c:Touch.Command="{Binding SaveCommand}"
                HorizontalTextAlignment="End"
                Style="{StaticResource LinkLabel}"
                Text="{l:Tr Common_Save}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,12,20,32" Spacing="20">

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Recipe_Name}" />
                    <Border Style="{StaticResource InputField}">
                        <Entry
                            IsSpellCheckEnabled="False"
                            IsTextPredictionEnabled="False"
                            Keyboard="Text"
                            MaxLength="120"
                            Placeholder="{l:Tr Recipe_NamePlaceholder}"
                            Text="{Binding Name}" />
                    </Border>
                </VerticalStackLayout>

                <!-- Ingredients -->
                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Recipe_Ingredients}" />
                    <Border Padding="16,4" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Ingredients}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:IngredientItem">
                                        <Grid Padding="0,10" c:Touch.Command="{Binding EditCommand}" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout VerticalOptions="Center">
                                                <Label LineBreakMode="TailTruncation" Text="{Binding Name}" />
                                                <Label Style="{StaticResource Caption}" Text="{Binding Detail}" />
                                            </VerticalStackLayout>
                                            <Label
                                                Grid.Column="1"
                                                Style="{StaticResource Secondary}"
                                                Text="{Binding KcalText}"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <HorizontalStackLayout Padding="0,12" c:Touch.Command="{Binding AddIngredientCommand}" Spacing="6">
                                <c:IconView
                                    Color="{DynamicResource Accent}"
                                    Data="{x:Static c:Icons.Plus}"
                                    HeightRequest="16"
                                    StrokeWidth="2.4"
                                    VerticalOptions="Center"
                                    WidthRequest="16" />
                                <Label Style="{StaticResource LinkLabel}" Text="{l:Tr Recipe_AddIngredient}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Portions -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Style="{StaticResource Strong}" Text="{Binding ServingsText}" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="8">
                        <Border
                            c:Touch.Command="{Binding FewerServingsCommand}"
                            Style="{StaticResource IconButton}"
                            SemanticProperties.Description="−">
                            <Label FontFamily="OpenSansSemibold" FontSize="20" HorizontalOptions="Center" Text="−" VerticalOptions="Center" />
                        </Border>
                        <Border
                            c:Touch.Command="{Binding MoreServingsCommand}"
                            Style="{StaticResource IconButton}"
                            SemanticProperties.Description="+">
                            <c:IconView Color="{DynamicResource Accent}" Data="{x:Static c:Icons.Plus}" StrokeWidth="2.4" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Recipe_Cooked}" />
                    <Border Style="{StaticResource InputField}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Keyboard="Numeric" MaxLength="6" Placeholder="—" Text="{Binding CookedWeight}" />
                            <Label
                                Grid.Column="1"
                                Margin="0,0,4,0"
                                Style="{StaticResource Secondary}"
                                Text="g"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Label Style="{StaticResource Caption}" Text="{l:Tr Recipe_CookedHint}" />
                </VerticalStackLayout>

                <!-- Totals -->
                <Border
                    Background="{DynamicResource HeroGradient}"
                    IsVisible="{Binding HasIngredients}"
                    StrokeShape="RoundRectangle 22"
                    StrokeThickness="0">
                    <VerticalStackLayout Padding="20,16" Spacing="4">
                        <Label FontFamily="OpenSansSemibold" FontSize="18" Text="{Binding PortionText}" TextColor="White" />
                        <Label FontSize="14" Text="{Binding PortionMacrosText}" TextColor="White" />
                        <Label FontSize="13" Text="{Binding TotalText}" TextColor="{StaticResource WhiteSoft}" />
                        <Label FontSize="13" Text="{Binding RawWeightText}" TextColor="{StaticResource WhiteSoft}" />
                    </VerticalStackLayout>
                </Border>

                <Label IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" Text="{Binding ErrorMessage}" />

                <Label
                    c:Touch.Command="{Binding RemoveCommand}"
                    HorizontalOptions="Center"
                    IsVisible="{Binding CanRemove}"
                    Style="{StaticResource LinkLabel}"
                    Text="{l:Tr Recipe_Remove}"
                    TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
