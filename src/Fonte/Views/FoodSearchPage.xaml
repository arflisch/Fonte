<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Fonte.Views.FoodSearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Fonte.Controls"
    xmlns:l="clr-namespace:Fonte.Localization"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Fonte.ViewModels"
    x:DataType="vm:FoodSearchViewModel"
    ios:Page.ModalPresentationStyle="PageSheet"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All"
    Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Sheet header -->
        <Grid Padding="20,18,20,6" ColumnDefinitions="100,*,100">
            <Label
                c:Touch.Command="{Binding CancelCommand}"
                Style="{StaticResource LinkLabel}"
                Text="{l:Tr Common_Cancel}" />
            <Label Grid.Column="1" Style="{StaticResource PageTitle}" Text="{Binding Title}" />
            <ActivityIndicator
                Grid.Column="2"
                HeightRequest="22"
                HorizontalOptions="End"
                IsRunning="{Binding IsWorking}"
                IsVisible="{Binding IsWorking}"
                WidthRequest="22"
                Color="{DynamicResource Accent}" />
        </Grid>

        <!-- Search, scan and shelves -->
        <VerticalStackLayout Grid.Row="1" Padding="20,10,20,8" Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Border Padding="12,0" Style="{StaticResource InputField}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <c:IconView
                            Color="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                            Data="{x:Static c:Icons.Search}"
                            HeightRequest="18"
                            VerticalOptions="Center"
                            WidthRequest="18" />
                        <Entry
                            Grid.Column="1"
                            ClearButtonVisibility="WhileEditing"
                            IsSpellCheckEnabled="False"
                            IsTextPredictionEnabled="False"
                            Keyboard="Plain"
                            Placeholder="{l:Tr FoodSearch_Placeholder}"
                            ReturnCommand="{Binding SearchOnlineCommand}"
                            ReturnType="Search"
                            Text="{Binding Search}" />
                    </Grid>
                </Border>
                <Border
                    Grid.Column="1"
                    Padding="11"
                    c:Touch.Command="{Binding ScanCommand}"
                    Background="{DynamicResource AccentGradient}"
                    HeightRequest="46"
                    IsVisible="{Binding CanScan}"
                    StrokeShape="RoundRectangle 15"
                    StrokeThickness="0"
                    WidthRequest="46"
                    SemanticProperties.Description="{l:Tr FoodSearch_Scan}">
                    <c:IconView Color="White" Data="{x:Static c:Icons.Barcode}" />
                </Border>
            </Grid>

            <ScrollView
                Margin="-20,0"
                HorizontalScrollBarVisibility="Never"
                IsVisible="{Binding IsShelfVisible}"
                Orientation="Horizontal">
                <HorizontalStackLayout Padding="20,0" BindableLayout.ItemsSource="{Binding Shelves}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SelectableOption">
                            <Border c:Touch.Command="{Binding SelectCommand}" Style="{StaticResource Chip}">
                                <Border.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" TargetType="Border" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentGradient}" />
                                        <Setter Property="Stroke" Value="Transparent" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label FontFamily="OpenSansSemibold" FontSize="14" Text="{Binding Label}">
                                    <Label.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" TargetType="Label" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Foods}"
            SelectionMode="None"
            VerticalScrollBarVisibility="Never">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="8" Orientation="Vertical" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <Grid Margin="20,4,20,8" ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Padding="12" c:Touch.Command="{Binding CreateFoodCommand}" Style="{StaticResource Card}">
                        <HorizontalStackLayout Spacing="8">
                            <c:IconView
                                Color="{DynamicResource Accent}"
                                Data="{x:Static c:Icons.Plus}"
                                HeightRequest="18"
                                StrokeWidth="2.4"
                                VerticalOptions="Center"
                                WidthRequest="18" />
                            <Label Style="{StaticResource LinkLabel}" Text="{l:Tr FoodSearch_CreateFood}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Padding="12"
                        c:Touch.Command="{Binding CreateDishCommand}"
                        IsVisible="{Binding CanCreateDish}"
                        Style="{StaticResource Card}">
                        <HorizontalStackLayout Spacing="8">
                            <Label FontSize="16" Text="🍲" VerticalOptions="Center" />
                            <Label Style="{StaticResource LinkLabel}" Text="{l:Tr FoodSearch_CreateDish}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="30,30" IsVisible="{Binding HasNoFood}" Spacing="8">
                    <Label FontSize="40" HorizontalOptions="Center" Text="🍽️" />
                    <Label HorizontalTextAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding EmptyText}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:FoodItemViewModel">
                    <Border
                        Margin="20,0"
                        Padding="14,12"
                        c:Touch.Command="{Binding OpenCommand}"
                        Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                <Label LineBreakMode="TailTruncation" MaxLines="2" Style="{StaticResource Strong}" Text="{Binding Name}" />
                                <Label LineBreakMode="TailTruncation" Style="{StaticResource Caption}" Text="{Binding Caption}" />
                            </VerticalStackLayout>
                            <c:IconView
                                Grid.Column="1"
                                Color="#E8B22C"
                                Data="{x:Static c:Icons.Star}"
                                HeightRequest="16"
                                IsVisible="{Binding IsFavorite}"
                                VerticalOptions="Center"
                                WidthRequest="16" />
                            <Border
                                Grid.Column="1"
                                Padding="8"
                                c:Touch.Command="{Binding DeleteCommand}"
                                HeightRequest="34"
                                IsVisible="{Binding IsTemplate}"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="34"
                                SemanticProperties.Description="{l:Tr Common_More}">
                                <c:IconView
                                    Color="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                    Data="{x:Static c:Icons.More}" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <VerticalStackLayout Padding="20,12,20,30" Spacing="10">
                    <Border
                        Padding="14"
                        c:Touch.Command="{Binding SearchOnlineCommand}"
                        IsVisible="{Binding IsSearching}"
                        Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <c:IconView
                                Color="{DynamicResource Accent}"
                                Data="{x:Static c:Icons.Globe}"
                                HeightRequest="18"
                                VerticalOptions="Center"
                                WidthRequest="18" />
                            <Label
                                Grid.Column="1"
                                LineBreakMode="TailTruncation"
                                Style="{StaticResource LinkLabel}"
                                Text="{Binding OnlineText}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Label
                        FontSize="12"
                        IsVisible="{Binding IsOnline}"
                        Style="{StaticResource Caption}"
                        Text="{l:Tr FoodSearch_OffCredit}" />
                </VerticalStackLayout>
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>
