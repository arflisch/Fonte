<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Fonte.Views.ProgressPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Fonte.Controls"
    xmlns:l="clr-namespace:Fonte.Localization"
    xmlns:vm="clr-namespace:Fonte.ViewModels"
    x:DataType="vm:ProgressViewModel"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="None">

    <Grid SafeAreaEdges="Container,Container,Container,None" Style="{StaticResource PageColumn}">
        <ScrollView SafeAreaEdges="None">
            <VerticalStackLayout Padding="20,12,20,40" Spacing="18">

                <!-- Header and period -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Label Style="{StaticResource LargeTitle}" Text="{l:Tr Tab_Progress}" VerticalOptions="Center" />
                    <Border
                        Grid.Column="1"
                        Padding="3"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                        <Grid BindableLayout.ItemsSource="{Binding PeriodChips}" ColumnDefinitions="Auto,Auto">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SelectableOption">
                                    <Border
                                        Grid.Column="{Binding Column}"
                                        Padding="12,6"
                                        c:Touch.Command="{Binding SelectCommand}"
                                        BackgroundColor="Transparent"
                                        StrokeShape="RoundRectangle 11"
                                        StrokeThickness="0">
                                        <Border.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" TargetType="Border" Value="True">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="13"
                                            Opacity="{Binding LabelOpacity}"
                                            Text="{Binding Label}" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Nothing done yet -->
                <Border Padding="24,28" IsVisible="{Binding IsEmpty}" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label FontSize="44" HorizontalOptions="Center" Text="📊" />
                        <Label HorizontalTextAlignment="Center" Style="{StaticResource SectionTitle}" Text="{l:Tr Progress_EmptyTitle}" />
                        <Label HorizontalTextAlignment="Center" Style="{StaticResource Secondary}" Text="{l:Tr Progress_EmptyText}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Weekly volume -->
                <Border IsVisible="{Binding HasData}" Padding="16,14,16,10" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="2">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Style="{StaticResource Strong}" Text="{l:Tr Progress_Volume}" />
                            <Label
                                Grid.Column="1"
                                FontFamily="OpenSansSemibold"
                                FontSize="14"
                                Text="{Binding AverageText}"
                                TextColor="{DynamicResource Accent}" />
                        </Grid>
                        <Label Style="{StaticResource Caption}" Text="{Binding PeriodText}" />
                        <c:BarChartView
                            Margin="0,12,0,0"
                            HeightRequest="150"
                            LabelColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                            Labels="{Binding WeekLabels}"
                            PositiveColor="{DynamicResource Accent}"
                            Values="{Binding Volumes}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Sets per muscle group -->
                <Border IsVisible="{Binding HasData}" Padding="16,14" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="0">
                            <Label Style="{StaticResource Strong}" Text="{l:Tr Progress_Muscles}" />
                            <Label Style="{StaticResource Caption}" Text="{l:Tr Progress_MusclesHint}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Muscles}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:MuscleBarItem">
                                    <Grid ColumnDefinitions="92,*,30" ColumnSpacing="10">
                                        <Label FontFamily="OpenSansSemibold" FontSize="14" Text="{Binding Name}" VerticalOptions="Center" />
                                        <c:ProgressPill
                                            Grid.Column="1"
                                            FillColor="{Binding Color}"
                                            HeightRequest="10"
                                            Progress="{Binding Progress}"
                                            TrackColor="{Binding TrackColor}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="2"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="14"
                                            HorizontalTextAlignment="End"
                                            Text="{Binding CountText}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Border
                            Padding="12,10"
                            BackgroundColor="#1FEF9F27"
                            IsVisible="{Binding HasAlert}"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <c:IconView
                                    Color="#BA7517"
                                    Data="{x:Static c:Icons.Warning}"
                                    HeightRequest="20"
                                    VerticalOptions="Center"
                                    WidthRequest="20" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="14"
                                    Text="{Binding AlertText}"
                                    TextColor="{AppThemeBinding Light=#8A5410, Dark=#F2C27A}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Records of the month -->
                <Border IsVisible="{Binding HasData}" Padding="16,14" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <HorizontalStackLayout Spacing="8">
                            <c:IconView
                                Color="#BA7517"
                                Data="{x:Static c:Icons.Trophy}"
                                HeightRequest="20"
                                VerticalOptions="Center"
                                WidthRequest="20" />
                            <Label Style="{StaticResource Strong}" Text="{l:Tr Progress_Records}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label IsVisible="{Binding HasRecords, Converter={StaticResource InvertBool}}" Style="{StaticResource Caption}" Text="{l:Tr Progress_NoRecord}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Records}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:MonthRecordItem">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="0">
                                            <Label FontFamily="OpenSansSemibold" Text="{Binding Name}" />
                                            <Label Style="{StaticResource Caption}" Text="{Binding DayText}" />
                                        </VerticalStackLayout>
                                        <Border
                                            Grid.Column="1"
                                            Padding="10,5"
                                            BackgroundColor="#26EF9F27"
                                            StrokeShape="RoundRectangle 12"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">
                                            <Label FontFamily="OpenSansSemibold" FontSize="14" Text="{Binding SetText}" TextColor="#BA7517" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
