<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Fonte.Views.PlatesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Fonte.Controls"
    xmlns:l="clr-namespace:Fonte.Localization"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Fonte.ViewModels"
    x:DataType="vm:PlatesViewModel"
    ios:Page.ModalPresentationStyle="PageSheet"
    HideSoftInputOnTapped="True"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All"
    Shell.PresentationMode="ModalAnimated">

    <ContentPage.Resources>
        <Style x:Key="StepButton" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}" />
            <Setter Property="HeightRequest" Value="52" />
            <Setter Property="WidthRequest" Value="64" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- Sheet header -->
        <Grid Padding="20,18,20,6" ColumnDefinitions="90,*,90">
            <Label
                c:Touch.Command="{Binding CloseCommand}"
                Style="{StaticResource LinkLabel}"
                Text="{l:Tr Common_Close}" />
            <Label Grid.Column="1" Style="{StaticResource PageTitle}" Text="{l:Tr Plates_Title}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,10,20,32" Spacing="18">

                <!-- Load aimed for -->
                <Border Padding="16" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14">
                        <Label HorizontalTextAlignment="Center" Style="{StaticResource FieldLabel}" Text="{l:Tr Plates_Target}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border c:Touch.Command="{Binding RemoveCommand}" Style="{StaticResource StepButton}">
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="17"
                                    HorizontalOptions="Center"
                                    Text="{Binding RemoveText}"
                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkMode}}"
                                    VerticalOptions="Center" />
                            </Border>
                            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                                <Entry
                                    FontFamily="OpenSansSemibold"
                                    FontSize="36"
                                    HorizontalTextAlignment="End"
                                    Keyboard="Numeric"
                                    MaxLength="6"
                                    MinimumWidthRequest="80"
                                    Text="{Binding TargetText}"
                                    VerticalOptions="Center" />
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="22"
                                    Style="{StaticResource Secondary}"
                                    Text="kg"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border Grid.Column="2" c:Touch.Command="{Binding AddCommand}" Style="{StaticResource StepButton}">
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="17"
                                    HorizontalOptions="Center"
                                    Text="{Binding AddText}"
                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkMode}}"
                                    VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <!-- Bar -->
                        <Grid BindableLayout.ItemsSource="{Binding Bars}" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SelectableOption">
                                    <Border
                                        Grid.Column="{Binding Column}"
                                        Padding="0,8"
                                        c:Touch.Command="{Binding SelectCommand}"
                                        Style="{StaticResource Chip}">
                                        <Border.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" TargetType="Border" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentGradient}" />
                                                <Setter Property="Stroke" Value="Transparent" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="14"
                                            HorizontalOptions="Center"
                                            Text="{Binding Label}">
                                            <Label.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" TargetType="Label" Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>
                        <Label HorizontalTextAlignment="Center" Style="{StaticResource Caption}" Text="{l:Tr Plates_BarHint}" />
                    </VerticalStackLayout>
                </Border>

                <!-- One side of the bar -->
                <Border Padding="16" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14">
                        <Label Style="{StaticResource Strong}" Text="{Binding ResultText}" />
                        <Grid HeightRequest="140" IsVisible="{Binding HasPlates}">
                            <!-- The bar's sleeve -->
                            <BoxView
                                CornerRadius="4"
                                HeightRequest="14"
                                VerticalOptions="Center"
                                Color="{AppThemeBinding Light=#94A3B8, Dark=#5B6475}" />
                            <HorizontalStackLayout
                                Margin="18,0,0,0"
                                BindableLayout.ItemsSource="{Binding PerSide}"
                                Spacing="3"
                                VerticalOptions="Center">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlateItem">
                                        <BoxView
                                            CornerRadius="4"
                                            HeightRequest="{Binding Height}"
                                            VerticalOptions="Center"
                                            WidthRequest="{Binding Width}"
                                            Color="{Binding Color}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlateRow">
                                    <HorizontalStackLayout Spacing="10">
                                        <Ellipse
                                            Fill="{Binding Color}"
                                            HeightRequest="14"
                                            VerticalOptions="Center"
                                            WidthRequest="14" />
                                        <Label FontFamily="OpenSansSemibold" Text="{Binding Text}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Warm-up -->
                <Border IsVisible="{Binding HasWarmUp}" Padding="16,14" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="8">
                            <c:IconView
                                Color="#EF6C27"
                                Data="{x:Static c:Icons.Flame}"
                                HeightRequest="20"
                                VerticalOptions="Center"
                                WidthRequest="20" />
                            <Label Style="{StaticResource Strong}" Text="{l:Tr Plates_WarmUp}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label FontFamily="OpenSansSemibold" FontSize="15" Text="{Binding WarmUpText}" />
                    </VerticalStackLayout>
                </Border>

                <Label HorizontalTextAlignment="Center" Style="{StaticResource Caption}" Text="{Binding PlatesText}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
