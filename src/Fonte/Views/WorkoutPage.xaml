<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Fonte.Views.WorkoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Fonte.Controls"
    xmlns:l="clr-namespace:Fonte.Localization"
    xmlns:vm="clr-namespace:Fonte.ViewModels"
    x:DataType="vm:WorkoutViewModel"
    HideSoftInputOnTapped="True"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    SafeAreaEdges="None">

    <ContentPage.Resources>
        <Style x:Key="ColumnHeader" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="0.6" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
        </Style>
        <Style x:Key="SetField" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
        <Style x:Key="SetEntry" TargetType="Entry">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="Keyboard" Value="Numeric" />
            <Setter Property="MaxLength" Value="6" />
            <Setter Property="MinimumHeightRequest" Value="40" />
            <Setter Property="Placeholder" Value="0" />
        </Style>
        <Style x:Key="RestButton" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{DynamicResource AccentButton}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="MinimumWidthRequest" Value="52" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="RestButtonText" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="TextColor" Value="{DynamicResource AccentOnButton}" />
        </Style>
    </ContentPage.Resources>

    <Grid
        RowDefinitions="Auto,*"
        SafeAreaEdges="Container,Container,Container,None"
        Style="{StaticResource PageColumn}">

        <!-- Top bar -->
        <Grid Padding="20,8,20,6" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border
                c:Touch.Command="{Binding GoBackCommand}"
                Style="{StaticResource IconButton}"
                SemanticProperties.Description="{l:Tr Common_Back}">
                <c:IconView Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" Data="{x:Static c:Icons.ChevronDown}" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                <Label Style="{StaticResource PageTitle}" Text="{Binding Title}" />
                <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="14"
                    HorizontalTextAlignment="Center"
                    Text="{Binding ElapsedText}"
                    TextColor="{DynamicResource Accent}" />
            </VerticalStackLayout>
            <Border
                Grid.Column="2"
                Padding="18,0"
                c:Touch.Command="{Binding FinishCommand}"
                Background="{DynamicResource AccentGradient}"
                HeightRequest="42"
                StrokeShape="RoundRectangle 21"
                StrokeThickness="0"
                VerticalOptions="Center">
                <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="15"
                    Text="{l:Tr Workout_Finish}"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Border>
        </Grid>

        <ScrollView x:Name="Scroll" Grid.Row="1" SafeAreaEdges="None">
            <VerticalStackLayout Padding="16,8,16,190" Spacing="14">

                <!-- No exercise yet -->
                <Border Padding="24,28" IsVisible="{Binding IsEmpty}" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label FontSize="48" HorizontalOptions="Center" Text="🏋️" />
                        <Label
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource SectionTitle}"
                            Text="{l:Tr Workout_EmptyTitle}" />
                        <Label
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource Secondary}"
                            Text="{l:Tr Workout_EmptyText}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Exercises -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Exercises}" Spacing="0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkoutExerciseViewModel">
                          <VerticalStackLayout Spacing="0">
                            <Border Padding="14,14,14,4" Style="{StaticResource Card}">
                                <Border.Triggers>
                                    <DataTrigger Binding="{Binding IsLinkedFromPrevious}" TargetType="Border" Value="True">
                                        <Setter Property="Stroke" Value="{DynamicResource Accent}" />
                                        <Setter Property="StrokeThickness" Value="1.5" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLinkedToNext}" TargetType="Border" Value="True">
                                        <Setter Property="Stroke" Value="{DynamicResource Accent}" />
                                        <Setter Property="StrokeThickness" Value="1.5" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Label Style="{StaticResource Strong}" Text="{Binding Name}" />
                                            <HorizontalStackLayout Spacing="6">
                                                <Ellipse
                                                    Fill="{Binding Color}"
                                                    HeightRequest="8"
                                                    VerticalOptions="Center"
                                                    WidthRequest="8" />
                                                <Label Style="{StaticResource Caption}" Text="{Binding MuscleText}" />
                                            </HorizontalStackLayout>
                                            <Border
                                                Margin="0,6,0,0"
                                                Padding="8,3"
                                                BackgroundColor="{DynamicResource AccentSoft}"
                                                HorizontalOptions="Start"
                                                IsVisible="{Binding HasTarget}"
                                                StrokeShape="RoundRectangle 9"
                                                StrokeThickness="0">
                                                <HorizontalStackLayout Spacing="4">
                                                    <c:IconView
                                                        Color="{DynamicResource Accent}"
                                                        Data="{x:Static c:Icons.Target}"
                                                        HeightRequest="13"
                                                        VerticalOptions="Center"
                                                        WidthRequest="13" />
                                                    <Label
                                                        FontFamily="OpenSansSemibold"
                                                        FontSize="12"
                                                        Text="{Binding TargetText}"
                                                        TextColor="{DynamicResource Accent}"
                                                        VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </VerticalStackLayout>
                                        <Border
                                            Grid.Column="1"
                                            Padding="8"
                                            c:Touch.Command="{Binding MenuCommand}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                                            HeightRequest="36"
                                            StrokeShape="RoundRectangle 18"
                                            StrokeThickness="0"
                                            VerticalOptions="Start"
                                            WidthRequest="36"
                                            SemanticProperties.Description="{l:Tr Workout_ExerciseOptions}">
                                            <c:IconView
                                                Color="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                                Data="{x:Static c:Icons.More}"
                                                StrokeWidth="3.2" />
                                        </Border>
                                    </Grid>

                                    <!-- Column headers -->
                                    <Grid
                                        Margin="0,6,0,0"
                                        ColumnDefinitions="34,*,76,68,40"
                                        ColumnSpacing="8">
                                        <Label Style="{StaticResource ColumnHeader}" Text="{l:Tr Workout_ColSet}" />
                                        <Label
                                            Grid.Column="1"
                                            Grid.ColumnSpan="{Binding PreviousSpan}"
                                            Style="{StaticResource ColumnHeader}"
                                            Text="{l:Tr Workout_ColPrevious}" />
                                        <Label
                                            Grid.Column="2"
                                            IsVisible="{Binding ShowWeight}"
                                            Style="{StaticResource ColumnHeader}"
                                            Text="{l:Tr Workout_ColKg}" />
                                        <Label
                                            Grid.Column="3"
                                            Style="{StaticResource ColumnHeader}"
                                            Text="{Binding ValueHeader}" />
                                    </Grid>

                                    <!-- Sets -->
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sets}" Spacing="4">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SetRowViewModel">
                                                <Border
                                                    Margin="-6,0"
                                                    Padding="6,4"
                                                    BackgroundColor="Transparent"
                                                    StrokeShape="RoundRectangle 12"
                                                    StrokeThickness="0">
                                                    <Border.Triggers>
                                                        <DataTrigger Binding="{Binding IsDone}" TargetType="Border" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PositiveSoftLight}, Dark={StaticResource PositiveSoftDark}}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Grid ColumnDefinitions="34,*,76,68,40" ColumnSpacing="8">
                                                        <Label
                                                            c:Touch.Command="{Binding MenuCommand}"
                                                            FontFamily="OpenSansSemibold"
                                                            FontSize="16"
                                                            HeightRequest="40"
                                                            HorizontalTextAlignment="Center"
                                                            Text="{Binding Number}"
                                                            VerticalTextAlignment="Center" />
                                                        <Label
                                                            Grid.Column="1"
                                                            Grid.ColumnSpan="{Binding PreviousSpan}"
                                                            HorizontalTextAlignment="Center"
                                                            LineBreakMode="TailTruncation"
                                                            Style="{StaticResource Caption}"
                                                            Text="{Binding PreviousText}"
                                                            VerticalTextAlignment="Center" />
                                                        <Border
                                                            Grid.Column="2"
                                                            IsVisible="{Binding ShowWeight}"
                                                            Style="{StaticResource SetField}">
                                                            <Entry Style="{StaticResource SetEntry}" Text="{Binding WeightText}" />
                                                        </Border>
                                                        <Border Grid.Column="3" Style="{StaticResource SetField}">
                                                            <Entry Style="{StaticResource SetEntry}" Text="{Binding ValueText}" />
                                                        </Border>
                                                        <Border
                                                            Grid.Column="4"
                                                            Padding="9"
                                                            c:Touch.Command="{Binding ToggleCommand}"
                                                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                                                            HeightRequest="40"
                                                            StrokeShape="RoundRectangle 12"
                                                            StrokeThickness="0"
                                                            WidthRequest="40"
                                                            SemanticProperties.Description="{l:Tr Workout_TickSet}">
                                                            <Border.Triggers>
                                                                <DataTrigger Binding="{Binding IsDone}" TargetType="Border" Value="True">
                                                                    <Setter Property="BackgroundColor" Value="{StaticResource Positive}" />
                                                                </DataTrigger>
                                                            </Border.Triggers>
                                                            <c:IconView
                                                                Color="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                                                                Data="{x:Static c:Icons.Check}"
                                                                StrokeWidth="2.8">
                                                                <c:IconView.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDone}" TargetType="c:IconView" Value="True">
                                                                        <Setter Property="Color" Value="White" />
                                                                    </DataTrigger>
                                                                </c:IconView.Triggers>
                                                            </c:IconView>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <!-- Add a set -->
                                    <HorizontalStackLayout
                                        Padding="0,10"
                                        c:Touch.Command="{Binding AddSetCommand}"
                                        HorizontalOptions="Center"
                                        Spacing="6">
                                        <c:IconView
                                            Color="{DynamicResource Accent}"
                                            Data="{x:Static c:Icons.Plus}"
                                            HeightRequest="16"
                                            StrokeWidth="2.6"
                                            VerticalOptions="Center"
                                            WidthRequest="16" />
                                        <Label Style="{StaticResource LinkLabel}" Text="{l:Tr Workout_AddSet}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Superset with the next exercise: no rest in between -->
                            <Grid HeightRequest="34" IsVisible="{Binding IsLinkedToNext}">
                                <BoxView
                                    HorizontalOptions="Center"
                                    WidthRequest="2"
                                    Color="{DynamicResource Accent}" />
                                <Border
                                    Padding="10,3"
                                    Background="{DynamicResource AccentGradient}"
                                    HorizontalOptions="Center"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="4">
                                        <c:IconView
                                            Color="White"
                                            Data="{x:Static c:Icons.Link}"
                                            HeightRequest="13"
                                            VerticalOptions="Center"
                                            WidthRequest="13" />
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="11"
                                            Text="{l:Tr Template_Superset}"
                                            TextColor="White"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                            <BoxView HeightRequest="14" IsVisible="{Binding IsLinkedToNext, Converter={StaticResource InvertBool}}" Color="Transparent" />
                          </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Add an exercise -->
                <Border
                    x:Name="AddExerciseButton"
                    Margin="0,4,0,0"
                    c:Touch.Command="{Binding AddExerciseCommand}"
                    Style="{StaticResource PrimaryButton}">
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <c:IconView
                            Color="White"
                            Data="{x:Static c:Icons.Plus}"
                            HeightRequest="20"
                            StrokeWidth="2.6"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label Style="{StaticResource PrimaryButtonText}" Text="{l:Tr Workout_AddExercise}" />
                    </HorizontalStackLayout>
                </Border>

                <Label
                    Padding="0,10"
                    c:Touch.Command="{Binding DiscardCommand}"
                    FontFamily="OpenSansSemibold"
                    HorizontalOptions="Center"
                    Text="{l:Tr Workout_Discard}"
                    TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Rest countdown, floating above the list -->
        <Grid
            Grid.Row="1"
            CascadeInputTransparent="False"
            InputTransparent="True"
            SafeAreaEdges="Container">
            <Border
                Margin="16,0,16,16"
                Padding="16,14"
                BackgroundColor="{DynamicResource AccentSoft}"
                IsVisible="{Binding IsResting}"
                Shadow="{DynamicResource FloatingShadow}"
                StrokeShape="RoundRectangle 24"
                StrokeThickness="0"
                VerticalOptions="End">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                        <c:IconView
                            Color="{DynamicResource Accent}"
                            Data="{x:Static c:Icons.Timer}"
                            HeightRequest="26"
                            VerticalOptions="Center"
                            WidthRequest="26" />
                        <VerticalStackLayout Grid.Column="1" Spacing="-4" VerticalOptions="Center">
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="12"
                                Text="{l:Tr Workout_Rest}"
                                TextColor="{DynamicResource Accent}" />
                            <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="28"
                                Text="{Binding RestText}"
                                TextColor="{DynamicResource AccentInk}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" c:Touch.Command="{Binding RemoveRestCommand}" Style="{StaticResource RestButton}">
                            <Label Style="{StaticResource RestButtonText}" Text="−15" />
                        </Border>
                        <Border Grid.Column="3" c:Touch.Command="{Binding AddRestCommand}" Style="{StaticResource RestButton}">
                            <Label Style="{StaticResource RestButtonText}" Text="+15" />
                        </Border>
                        <Border
                            Grid.Column="4"
                            c:Touch.Command="{Binding SkipRestCommand}"
                            Background="{DynamicResource AccentGradient}"
                            Style="{StaticResource RestButton}">
                            <Label Style="{StaticResource RestButtonText}" Text="{l:Tr Workout_Skip}" TextColor="White" />
                        </Border>
                    </Grid>
                    <c:ProgressPill
                        FillColor="{DynamicResource Accent}"
                        HeightRequest="6"
                        Progress="{Binding RestProgress}"
                        TrackColor="{DynamicResource AccentTrack}" />
                </VerticalStackLayout>
            </Border>

            <!-- The rest is over -->
            <Border
                Margin="16,0,16,16"
                Padding="18,16"
                BackgroundColor="{StaticResource Positive}"
                IsVisible="{Binding IsRestOver}"
                StrokeShape="RoundRectangle 24"
                StrokeThickness="0"
                VerticalOptions="End">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                    <c:IconView
                        Color="White"
                        Data="{x:Static c:Icons.Check}"
                        HeightRequest="22"
                        StrokeWidth="2.8"
                        VerticalOptions="Center"
                        WidthRequest="22" />
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="17"
                        Text="{l:Tr Workout_RestOver}"
                        TextColor="White"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
